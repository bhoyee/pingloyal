# Environment files — NEVER commit these
.env
.env.local
.env.development
.env.production
.env.test

# Dependencies
node_modules/

# Build outputs — app artifacts only (packages/*/dist/ IS committed — needed at runtime)
apps/*/dist/
.next/
build/

# Test coverage reports
apps/*/coverage/

# TypeScript incremental compilation cache
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/settings.json
.idea/