{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@pingloyal/types": ["../../packages/types/src/index.ts"],
      "@pingloyal/types/*": ["../../packages/types/src/*"],
      "@pingloyal/utils": ["../../packages/utils/src/index.ts"],
      "@pingloyal/utils/*": ["../../packages/utils/src/*"],
      "@pingloyal/zod-schemas": ["../../packages/zod-schemas/src/index.ts"],
      "@pingloyal/zod-schemas/*": ["../../packages/zod-schemas/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
