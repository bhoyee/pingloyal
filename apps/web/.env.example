# API is proxied through Next.js rewrites (/api/v1/* → localhost:3333)
# so the browser never needs to know the backend address directly.
# Change INTERNAL_API_URL if your API runs on a different port.
INTERNAL_API_URL=http://localhost:3333

# "Chat on WhatsApp" link on the Help & Support page (E.164, no '+')
NEXT_PUBLIC_SUPPORT_WHATSAPP=2349094135585
