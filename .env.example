# Database
DATABASE_URL=postgresql://pingloyal:password@localhost:5432/pingloyal_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-different-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (32-byte hex = 64 characters)
ENCRYPTION_KEY=replace-with-64-char-hex-string

# Gupshup
GUPSHUP_PARTNER_KEY=
GUPSHUP_PARTNER_ID=
GUPSHUP_PARTNER_API_URL=https://partner.gupshup.io/partner
GUPSHUP_API_URL=https://api.gupshup.io/sm/api/v1

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Stripe (UK - optional for MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=pingloyal-assets

# Email (Resend)
RESEND_API_KEY=re_xxxx

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

