# Database
DATABASE_URL=postgresql://pingloyal:password@localhost:5432/pingloyal_dev

# Redis (docker-compose maps host:6380 → container:6379)
REDIS_URL=redis://localhost:6380

# JWT RS256 key pair (base64-encoded PEM)
# Generate: openssl genrsa -out private.pem 2048
#           openssl rsa -in private.pem -pubout -out public.pem
#           base64 -w 0 private.pem  → JWT_PRIVATE_KEY
#           base64 -w 0 public.pem   → JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=<base64-encoded-rsa-private-key-pem>
JWT_PUBLIC_KEY=<base64-encoded-rsa-public-key-pem>
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Encryption (32-byte hex = 64 characters)
ENCRYPTION_KEY=replace-with-64-char-hex-string

# Gupshup BSP
GUPSHUP_PARTNER_KEY=
GUPSHUP_PARTNER_ID=
GUPSHUP_PARTNER_API_URL=https://partner.gupshup.io/partner
GUPSHUP_API_URL=https://api.gupshup.io/sm/api/v1
WA_APP_SECRET=                  # Meta app secret for webhook signature verification

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxx

# Stripe (UK - optional for MVP)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=pingloyal-assets

# Email (Resend)
RESEND_API_KEY=re_xxxx
MAIL_FROM=PingLoyal <noreply@pingloyal.com>
SUPPORT_EMAIL=support@pingloyal.com

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3001

# Queue dashboard (Basic auth for /admin/queues)
ADMIN_QUEUE_USER=admin
ADMIN_QUEUE_PASS=changeme123

# Sentry (optional for dev)
SENTRY_DSN=

# Logging
LOG_LEVEL=info